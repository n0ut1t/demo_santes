{
  "cleanUrls": true,
  "trailingSlash": true,
  "rewrites": [
    { "source": "/an/:path*", "destination": "/codigo%20santas/an/:path*" },
    { "source": "/ol/:path*", "destination": "/codigo%20santas/ol/:path*" },
    { "source": "/ik/:path*", "destination": "/codigo%20santas/ik/:path*" },
    { "source": "/index.html", "destination": "/codigo%20santas/ik/index.html" },
    { "source": "/:path*", "destination": "/codigo%20santas/ik/:path*" }
  ]
}
